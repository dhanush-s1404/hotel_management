# Hotel Management System - Environment Variables

# Server
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=${DATABASE_URL:-postgresql://${POSTGRES_USER:-app_user}:${POSTGRES_PASSWORD:-strong_password}@localhost:5432/hotel_management}

# Security
# SECRET_KEY must be set via environment variable (minimum 32 characters)
# Do NOT use the default in production
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000 http://127.0.0.1:3000